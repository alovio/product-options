{
  "name": "corelabs/advanced-product-options",
  "description": "Custom product fields with a drag-drop builder and conditional logic for WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "version": "0.1.0",
  "require": { "php": ">=7.4" },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "brain/monkey": "^2",
    "yoast/phpunit-polyfills": "^2"
  },
  "autoload": { "psr-4": { "APO\\": "includes/" } },
  "autoload-dev": { "psr-4": { "APO\\Tests\\": "tests/php/" } },
  "scripts": { "test": "phpunit -c phpunit.xml.dist" },
  "config": { "allow-plugins": { "*": true } }
}
